# ------------------------------------------------------------------------------
# | Single Page Application (SPA) URL Rewriting for Apache & LiteSpeed        |
# ------------------------------------------------------------------------------

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # If the requested file or directory exists, serve it directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Don't rewrite sitemap or robots if handled as static files
  RewriteRule ^robots\.txt$ - [L]
  RewriteRule ^sitemap\.xml$ - [L]
  RewriteRule ^llms\.txt$ - [L]
  RewriteRule ^llms-full\.txt$ - [L]

  # ------------------------------------------------------------------
  # Bot SEO Proxy: pass crawler traffic to Express API for OG injection
  # The Express botSeoMiddleware returns server-rendered HTML with all
  # <meta> OG tags so social scrapers (WhatsApp, Facebook, LinkedIn)
  # and search engines (Googlebot, Bingbot) get proper metadata.
  #
  # Wrapped in <IfModule mod_proxy.c> as defensive guard:
  # If mod_proxy is disabled on Hostinger shared Apache, requests
  # fall back safely to index.html without throwing a 500 error.
  # ------------------------------------------------------------------
  <IfModule mod_proxy.c>
    RewriteCond %{HTTP_USER_AGENT} "(googlebot|google-inspectiontool|bingbot|bingpreview|yandexbot|duckduckbot|facebookexternalhit|facebot|whatsapp|linkedinbot|pinterest|telegrambot|slackbot|discordbot|twitterbot|gptbot|chatgpt-user|perplexitybot|amazonbot|diffbot|semrushbot|ahrefsbot|applebot)" [NC]
    RewriteRule ^(book|category|blog)/(.+)$ https://api.technoworldbooks.in/$1/$2 [P,L]

    RewriteCond %{HTTP_USER_AGENT} "(googlebot|google-inspectiontool|bingbot|bingpreview|yandexbot|duckduckbot|facebookexternalhit|facebot|whatsapp|linkedinbot|pinterest|telegrambot|slackbot|discordbot|twitterbot|gptbot|chatgpt-user|perplexitybot|amazonbot|diffbot|semrushbot|ahrefsbot|applebot)" [NC]
    RewriteRule ^$ https://api.technoworldbooks.in/ [P,L]
  </IfModule>

  # Route all other URLs to index.html for client-side routing
  RewriteRule ^ index.html [L]
</IfModule>

# Fallback for Apache 2.4+ / LiteSpeed if mod_rewrite is disabled
<IfModule !mod_rewrite.c>
  FallbackResource /index.html
</IfModule>

# Disable Directory Browsing
Options -Indexes

# Proper MIME types for modern web assets
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType application/json .json
  AddType font/woff .woff
  AddType font/woff2 .woff2
  AddType "text/plain; charset=utf-8" .txt
</IfModule>

# Ensure LLM discovery and crawler protocol files are served with UTF-8 text/plain
<FilesMatch "^(llms|llms-full|robots)\.txt$">
  <IfModule mod_headers.c>
    Header set Content-Type "text/plain; charset=utf-8"
    Header set Cache-Control "public, max-age=86400"
  </IfModule>
</FilesMatch>

# Prevent caching of index.html so updates are immediate
<Files "index.html">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </IfModule>
</Files>
